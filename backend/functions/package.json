{
  "name": "skeleton-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "deploy": "firebase deploy --config ../firebase.json --only functions",
    "test:rules:unit": "node --test test/rules.test.cjs",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project demo-skeleton --only firestore,storage \"npm run test:rules:unit\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.27.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "firebase-tools": {
      "tar": "^7.5.22"
    },
    "uuid": "^11.1.1"
  }
}

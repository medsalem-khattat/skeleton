rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Fields the app may write on its own profile. Server-trusted fields
    // (roles, plans, entitlements) must never be added to this list.
    function profileFields() {
      return ['name', 'email', 'photoStoragePath', 'notificationsEnabled'];
    }

    function validProfileValues(uid) {
      let data = request.resource.data;
      return (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('email' in data) || data.email == null || data.email is string)
        && (!('photoStoragePath' in data)
          || (data.photoStoragePath is string
            && data.photoStoragePath.matches('users/' + uid + '/profile/[^/]+')))
        && (!('notificationsEnabled' in data) || data.notificationsEnabled is bool);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(profileFields())
        && validProfileValues(uid);

      // Only the changed keys are checked, so documents written by older
      // releases keep any legacy fields they already have.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(profileFields())
        && validProfileValues(uid);

      // Account deletion runs through the deleteAccount function.
      allow delete: if false;
    }

    match /users/{uid}/notifications/{notificationId} {
      allow read: if isOwner(uid);

      // Inbox records are written only by trusted Cloud Functions.
      allow create: if false;

      allow update: if isOwner(uid)
        && resource.data.isRead == false
        && request.resource.data.isRead == true
        && request.resource.data.readAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'readAt']);

      allow delete: if false;
    }

    match /users/{uid}/fcmTokens/{tokenId} {
      allow read: if false;
      allow create, update: if isOwner(uid)
        && tokenId.size() >= 20
        && tokenId.size() <= 1500
        && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

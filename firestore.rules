rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/notifications/{notificationId} {
      allow read: if request.auth != null
        && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'type',
          'createdAt',
          'isRead'
        ])
        && request.resource.data.type == 'password_changed'
        && request.resource.data.createdAt == request.time
        && request.resource.data.isRead == false;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && resource.data.isRead == false
        && request.resource.data.isRead == true
        && request.resource.data.readAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'readAt']);

      allow delete: if false;
    }

    match /users/{uid}/fcmTokens/{tokenId} {
      allow read: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && tokenId.size() >= 20
        && tokenId.size() <= 1500
        && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

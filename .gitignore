# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
/coverage/
/backend/functions/node_modules/
/backend/functions/lib/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated per deployment by `node tool/deployment.mjs use <id>`.
# The source of truth is deployments/<id>/.
/frontend/deployment.g.json
/frontend/lib/firebase_options.dart
/frontend/firebase.json
/frontend/android/app/google-services.json
/frontend/android/deployment.properties
/frontend/ios/Runner/GoogleService-Info.plist
/frontend/ios/Flutter/Deployment.xcconfig
/backend/functions/.env.*

# Secrets belong to the customer and never enter this repository.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*service-account*.json

# Customer deployments live in each customer's own private repository and are
# fetched at build time (docs/DEPLOYMENT.md). Only our own are committed here.
/deployments/*
!/deployments/dev/
!/deployments/test/
!/deployments/demo/
!/deployments/example/
